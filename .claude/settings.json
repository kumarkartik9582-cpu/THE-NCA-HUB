{
    "$schema": "https://json.schemastore.org/claude-code-settings.json",
    "hooks": {
        "PreToolUse": [
            {
                "matcher": "Bash",
                "hooks": [
                    {
                        "type": "command",
                        "command": ".claude/hooks/commit-quality-check.sh"
                    }
                ]
            }
        ],
        "PostToolUse": [
            {
                "matcher": "Edit|Write",
                "hooks": [
                    {
                        "type": "command",
                        "command": ".claude/hooks/blog-auto-build.sh"
                    }
                ]
            }
        ]
    },
    "permissions": {
        "allow": [
            "Bash(node build.js)",
            "Bash(git status)",
            "Bash(git diff*)",
            "Bash(git log*)",
            "Bash(git branch*)",
            "Bash(git ls-files*)",
            "Bash(npm run*)",
            "Bash(ls *)",
            "Read(*)",
            "Glob(*)",
            "Grep(*)",
            "Skill"
        ]
    }
}
