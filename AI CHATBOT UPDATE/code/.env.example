# NCA Hub Real-Time Voice Chat — environment variables
# Copy to .env and fill in values before running locally or deploying

# ── Server ────────────────────────────────────────────────────────────
PORT=8000
MAX_AUDIO_QUEUE_SIZE=50

# ── LLM backend ───────────────────────────────────────────────────────
# "ollama"  → needs Ollama running locally (GPU recommended)
# "openai"  → uses OpenAI API (no GPU needed, costs per token)
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini

# Required only when LLM_PROVIDER=openai
OPENAI_API_KEY=sk-...

# ── STT / TTS ─────────────────────────────────────────────────────────
# TTS engine: "kokoro" (fast, CPU ok) | "coqui" (best quality, GPU) | "orpheus"
TTS_ENGINE=kokoro

# Whisper model for STT: tiny | base | small | medium | large-v3
STT_MODEL=base.en
